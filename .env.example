# RepoSentinel reads OPENAI_API_KEY from the process environment as well as
# the prefixed form. Copy this file to .env and fill in what you have.

# Required to run the agent (or point OPENAI_BASE_URL at a compatible server).
OPENAI_API_KEY=

# Optional. Unprefixed names work; prefixed names win when both are set.
# REPOSENTINEL_OPENAI_API_KEY=
# REPOSENTINEL_OPENAI_BASE_URL=
# REPOSENTINEL_DEFAULT_MODEL=gpt-4.1-mini

# Optional: Anthropic is listed as unavailable until a provider is added.
# ANTHROPIC_API_KEY=

# Optional: local models via Ollama's OpenAI-compatible endpoint.
# REPOSENTINEL_OLLAMA_BASE_URL=http://localhost:11434

# Sandbox: auto uses Docker when `docker` is on PATH, otherwise local subprocess.
# REPOSENTINEL_SANDBOX_BACKEND=auto

# Vector store: sqlite (default) or pgvector (requires DATABASE_URL).
# REPOSENTINEL_VECTOR_STORE=sqlite
# DATABASE_URL=postgresql://reposentinel:reposentinel@localhost:5432/reposentinel

# Human approval is required by default. Evaluation sets auto_approve per-run.
# REPOSENTINEL_REQUIRE_HUMAN_APPROVAL=true

# GitHub PRs are never opened unless both of these are set, a human approved
# the run, and the workspace has a GitHub remote.
# REPOSENTINEL_ALLOW_GITHUB_PUSH=false
# GITHUB_TOKEN=
